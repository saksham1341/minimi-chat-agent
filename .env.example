# Copy to .env and fill in. Every key is optional on its own; the app offers whatever is configured
# and says plainly what is missing. You need at least one model and one search provider.

# ---- Models: each provider's models appear in the composer's model picker ----

# Anthropic API: Claude Opus 5.5, Sonnet 5.5 and Haiku 5.5. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Amazon Bedrock: Claude Sonnet 4.5 by default. Leave the keys empty to use the AWS SDK's own
# credential chain (profile, SSO, instance role); a region is required either way.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
# Comma-separated Bedrock model ids. Default: global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODELS=

# ---- Web search: one is enough ----

# Exa (preferred: date filters, page text in the same call, live re-reads). https://exa.ai
EXA_API_KEY=
# Tavily, if you have that instead. https://tavily.com
TAVILY_API_KEY=
# When both are set: exa (default) or tavily.
SEARCH_PROVIDER=

# ---- Optional ----

# Which model the picker starts on, e.g. claude-sonnet-5-5 or bedrock:global.anthropic.claude-sonnet-4-5-20250929-v1:0
DEFAULT_MODEL=
# low (default, fastest) | medium | high: how hard the model thinks before answering.
EFFORT=
# The time zone used when the browser does not send one. Default: the server's.
TIME_ZONE=
# Pretend it is another moment (ISO 8601); the clock runs forward from there. For trying
# "what did I ask you on Monday?" without waiting a week.
AGENT_NOW=
# Where memory is kept. Default: data/memory.db
DATA_FILE=
# Where the agent runtime finds its tools (an MCP server). Default: this server's own /mcp.
MCP_ENDPOINT=
# Let other machines use this server's /mcp (for a runtime deployed elsewhere). Default: false.
MCP_ALLOW_REMOTE=
# Default 127.0.0.1:3000 (this machine only: there is no sign-in). HOST=0.0.0.0 opens it to your
# network or tailnet, and anyone there can then read the conversations and spend the keys.
HOST=
PORT=
